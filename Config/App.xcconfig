// Build settings for the GradHire app target (Debug and Release).
//
// Supabase values are read from Info.plist at runtime (see SupabaseManager).
// Real values live in Secrets.xcconfig, which is gitignored. The include is
// optional (#include?), so a fresh clone still builds without it; Supabase
// then reports "not configured" and the rest of the app works as before.

SUPABASE_URL =
SUPABASE_PUBLISHABLE_KEY =

// Google Sign-In. The scheme default is a harmless placeholder so Info.plist
// always has a valid URL type; Google sign-in reports "not configured" until
// real values are set in Secrets.xcconfig.
GOOGLE_IOS_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.not-configured

#include? "Secrets.xcconfig"
