// Copy this file to Config/Secrets.xcconfig and fill in real values.
// Secrets.xcconfig is gitignored; never commit it.
//
// Where to find the values: Supabase dashboard, project "gradhire" (Mumbai)
//   Settings > API Keys
//
// SUPABASE_URL: xcconfig treats "//" as the start of a comment, so write the
// URL with $() between the slashes: https:/$()/<project-ref>.supabase.co
//
// SUPABASE_PUBLISHABLE_KEY: the publishable (anon) key, which is safe to ship
// in the app because Row Level Security protects the data.
// NEVER put the secret / service_role key here; it belongs only on the backend.

SUPABASE_URL = https:/$()/gesokbuvafuswjgqaqfc.supabase.co
SUPABASE_PUBLISHABLE_KEY = your-publishable-key

// Google Sign-In: Google Cloud Console > APIs & Services > Credentials,
// the iOS OAuth client for bundle ID com.prakhar.gradhire.
// Client IDs are not secret, but they live here with the other per-project values.
GOOGLE_IOS_CLIENT_ID = your-ios-client-id.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.your-ios-client-id
